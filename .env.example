# ============================================================
# TwinDigital — Environment Variables Template
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ────────────────────────────────────────────────
POSTGRES_USER=twindigital
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# ── JWT & Authentication ────────────────────────────────────
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_EXPIRATION_MS=3600000
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=AdminPassword123!
BOOTSTRAP_ADMIN_EMAIL=admin@twindigital.local

# ── AWS ─────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012
EKS_CLUSTER_NAME=twindigital-cluster

# ── Cluster Sync ────────────────────────────────────────────
# Base64-encoded kubeconfig for local dev only.
# In EKS, use IRSA — leave this blank.
KUBECONFIG_BASE64=

# Seconds between full cluster topology syncs
SYNC_INTERVAL_SECONDS=30

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── Terraform Remote State ───────────────────────────────────
TF_STATE_BUCKET=twindigital-tfstate-CHANGE_ME
TF_STATE_REGION=ap-south-1
TF_STATE_DYNAMO_TABLE=twindigital-tflock
